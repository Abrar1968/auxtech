APP_NAME=Auxtech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://auxtechbd.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP defaults: MySQL/MariaDB on 127.0.0.1:3306, user root, empty password.
# Create the database first: CREATE DATABASE auxtech CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auxtech
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="auxtechbd@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Auxtech -----------------------------------------------------------
# First Super Admin, created by the database seeder (Phase 1).
ADMIN_NAME="Auxtech Admin"
ADMIN_EMAIL=auxtechbd@gmail.com
ADMIN_PASSWORD=

# Where new-lead emails are sent.
LEADS_NOTIFY_EMAIL=auxtechbd@gmail.com

# WhatsApp number in international format without "+".
WHATSAPP_NUMBER=8801805019415

# Inertia server-side rendering (run: php artisan inertia:start-ssr)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Optional integrations (can also be set in Admin > Settings)
GTM_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
