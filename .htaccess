# Shared-hosting entry point.
# When the project is unzipped straight into the domain's document root,
# this sends every request to /public and keeps everything else private.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git, ...) or application folders.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(app|bootstrap|config|database|docs|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|.*\.md)$ - [F,L]

    # Everything else is handled by Laravel's public folder.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
